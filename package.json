{
  "name": "overlay-desktop",
  "version": "0.1.23",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "license": "AGPL-3.0-or-later",
  "description": "overlay - personal computing, reimagined",
  "main": "./out/main/index.js",
  "author": "DevelopedByDev",
  "homepage": "https://github.com/LayerNorm/overlay-desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/LayerNorm/overlay-desktop.git"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "check:chat-transcript-boundaries": "node scripts/ensure-shared-chat-transcript.mjs && vitest run src/renderer/src/components/chat/desktopChatTranscriptAdapter.test.ts src/renderer/src/components/chat/embeddedChatTranscriptAdapter.test.ts",
    "check:file-parity-boundaries": "node scripts/ensure-shared-files-surface.mjs",
    "check:knowledge-surface-contract": "node scripts/check-standalone-knowledge-surface.mjs && node scripts/ensure-shared-files-surface.mjs && vitest run src/renderer/src/adapters/desktopKnowledgeSurfaceAdapters.test.ts src/renderer/src/adapters/desktopLocalKnowledgeSurfaceAdapters.test.ts src/main/services/native-knowledge-files.test.ts",
    "check:knowledge-migration": "node scripts/ensure-knowledge-migration.mjs && vitest run src/main/services/knowledge-migration-store.test.ts src/renderer/src/services/desktop-knowledge-migration.test.ts",
    "check:notebook-editor": "node scripts/ensure-shared-notebook-editor.mjs && vitest run src/renderer/src/features/notebook/desktopNotebookRepository.test.ts",
    "check:security-containment": "node scripts/check-security-containment.mjs && vitest run src/main/services/security/containment-capability-profile.test.ts",
    "check:agent-policy-boundary": "node scripts/check-agent-policy-boundary.mjs && vitest run src/types/agent-permissions.test.ts src/main/services/security/agent-policy/agent-policy-engine.test.ts src/main/services/security/agent-policy/approval-store.test.ts src/main/services/security/agent-policy/approval-coordinator.test.ts src/main/services/security/agent-policy/tool-policy-wrapper.test.ts src/main/services/security/agent-policy/agent-infrastructure.test.ts src/main/services/security/agent-policy/agent-task-security-session.test.ts src/main/services/security/agent-policy/agent-provider-input-validation.test.ts",
    "check:secure-electron-boundary": "node scripts/check-secure-electron-boundary.mjs && vitest run src/main/ipc/app-api-security.test.ts src/main/services/security/bounded-json-response.test.ts src/main/services/security/network-destination-policy.test.ts",
    "check:browser-network-boundary": "node scripts/check-browser-network-boundary.mjs && vitest run src/main/services/browser-manager-security.test.ts src/main/services/security/network-destination-policy.test.ts src/main/services/security/local-helper-process.test.ts",
    "check:release-security": "node scripts/check-release-security.mjs && node scripts/verify-native-artifacts.mjs && vitest run src/main/services/auto-updater-policy.test.ts src/shared/security/telemetry-redaction.test.ts",
    "check:native-artifacts": "node scripts/verify-native-artifacts.mjs",
    "check:public-source-secrets": "node scripts/check-public-source-secrets.mjs",
    "check:exploit-chains": "node scripts/check-security-verification.mjs && vitest run src/main/ipc/app-api-security.test.ts src/main/services/browser-manager-security.test.ts src/main/services/auto-updater-policy.test.ts src/main/services/security src/shared/security/telemetry-redaction.test.ts src/types/agent-permissions.test.ts",
    "security:verify:source": "npm run check:public-source-secrets && npm run check:exploit-chains && npm run check:dependencies:prod && npm run check:native-artifacts && npm test",
    "check:launch-controls": "node scripts/check-launch-controls.mjs",
    "check:dependencies:prod": "npm audit --omit=dev --audit-level=high",
    "check:dependencies:all": "npm audit --audit-level=high",
    "license:check": "node scripts/check-licensing.mjs",
    "check:standalone": "node scripts/check-standalone-repository.mjs",
    "check:public-tree": "node scripts/check-public-tree.mjs",
    "public:export": "node scripts/create-public-export.mjs",
    "generate:sbom": "node scripts/generate-sbom.mjs",
    "typecheck": "npm run check:security-containment && npm run check:agent-policy-boundary && npm run check:secure-electron-boundary && npm run check:browser-network-boundary && npm run check:release-security && npm run check:chat-transcript-boundaries && npm run check:file-parity-boundaries && npm run check:knowledge-surface-contract && npm run check:knowledge-migration && npm run check:notebook-editor && npm run typecheck:node && npm run typecheck:web",
    "test": "npm run test:desktop && npm run test:packages",
    "test:desktop": "vitest run",
    "test:packages": "npm test --workspaces --if-present",
    "test:watch": "vitest",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "chat-parity:dev": "OVERLAY_CHAT_PARITY_FIXTURE=1 electron-vite dev",
    "file-parity:dev": "OVERLAY_FILE_PARITY_FIXTURE=1 electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:ax-helper": "bash scripts/build-ax-helper.sh",
    "build:whisperkit": "bash scripts/build-whisperkit-bundle.sh",
    "build:parakeet": "bash scripts/build-parakeet-bundle.sh",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build:mac:ci",
    "build:mac:ci": "npm run build && electron-builder --mac --arm64 --publish never",
    "verify:mac-artifact": "node scripts/verify-macos-artifact.mjs",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.15",
    "@ai-sdk/gateway": "^3.0.66",
    "@ai-sdk/google": "^3.0.10",
    "@ai-sdk/groq": "^3.0.10",
    "@ai-sdk/openai": "^3.0.12",
    "@ai-sdk/xai": "^3.0.26",
    "@anthropic-ai/sdk": "^0.71.0",
    "@composio/core": "^0.6.4",
    "@composio/vercel": "^0.6.4",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@google/genai": "^1.30.0",
    "@lancedb/lancedb": "^0.23.0",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "@openrouter/sdk": "^0.9.11",
    "@sentry/electron": "7.15.0",
    "@sentry/react": "10.67.0",
    "@tiptap/extension-code-block-lowlight": "^3.20.1",
    "@tiptap/extension-emoji": "^3.20.1",
    "@tiptap/extension-highlight": "^3.20.1",
    "@tiptap/extension-image": "^3.20.1",
    "@tiptap/extension-link": "^3.20.1",
    "@tiptap/extension-mathematics": "^3.20.1",
    "@tiptap/extension-placeholder": "^3.20.1",
    "@tiptap/extension-subscript": "^3.20.1",
    "@tiptap/extension-superscript": "^3.20.1",
    "@tiptap/extension-table": "^3.20.1",
    "@tiptap/extension-table-cell": "^3.20.1",
    "@tiptap/extension-table-header": "^3.20.1",
    "@tiptap/extension-table-row": "^3.20.1",
    "@tiptap/extension-task-item": "^3.20.1",
    "@tiptap/extension-task-list": "^3.20.1",
    "@tiptap/extension-text-align": "^3.20.1",
    "@tiptap/extension-text-style": "^3.20.1",
    "@tiptap/extension-typography": "^3.20.1",
    "@tiptap/extension-underline": "^3.20.1",
    "@tiptap/extension-youtube": "^3.20.1",
    "@tiptap/pm": "^3.20.1",
    "@tiptap/react": "^3.20.1",
    "@tiptap/starter-kit": "^3.20.1",
    "@tiptap/suggestion": "^3.20.1",
    "@types/form-data": "^2.2.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "ai": "^6.0.39",
    "apache-arrow": "^18.1.0",
    "axios": "1.18.1",
    "csv-parse": "^6.1.0",
    "dompurify": "3.4.12",
    "dotenv": "^17.2.3",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.3.9",
    "form-data": "4.0.6",
    "groq-sdk": "^0.34.0",
    "katex": "^0.16.27",
    "keytar": "^7.9.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.575.0",
    "mammoth": "^1.11.0",
    "marked": "^17.0.2",
    "mixpanel-browser": "^2.74.0",
    "node-pty": "^1.1.0",
    "openai": "^6.15.0",
    "pdf-parse": "^2.4.5",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tippy.js": "^6.3.7",
    "uiohook-napi": "^1.5.4",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/asar": "4.2.1",
    "@electron/fuses": "2.1.3",
    "@overlay/api-client": "0.0.1",
    "@overlay/app-core": "0.0.1",
    "@overlay/auth-contracts": "0.0.1",
    "@overlay/billing": "0.0.1",
    "@overlay/chat-core": "0.0.1",
    "@overlay/chat-react": "0.0.1",
    "@overlay/llm-gateway": "0.0.1",
    "@overlay/modules-react": "0.0.1",
    "@overlay/storage-contracts": "0.0.1",
    "@overlay/tools-core": "0.0.1",
    "@overlay/ui": "0.0.1",
    "@types/node": "^22.18.6",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "autoprefixer": "^10.5.4",
    "electron": "39.8.10",
    "electron-builder": "26.15.3",
    "electron-vite": "^4.0.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "postcss": "^8.5.19",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.2",
    "vite": "7.3.6",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
