# Public client configuration only. Copy to .env.local for development.
# Never place provider owner keys, billing secrets, session secrets, signing
# credentials, release tokens, or production service credentials in this repo.

# Official hosted Overlay Server. For local web/server development use
# http://localhost:3000. Self-hosted production origins must use HTTPS.
APP_SERVER_URL=https://www.getoverlay.io

# Public OAuth client identifiers. Obtain values for your own deployment.
WORKOS_CLIENT_ID=client_replace_me
DEV_WORKOS_CLIENT_ID=client_replace_me
WORKOS_REDIRECT_URI=overlay://auth/callback

# Public Convex deployment URLs used only by legacy/local compatibility paths.
# Prefer server-authoritative /api/v1 routes for hosted product operations.
NEXT_PUBLIC_CONVEX_URL=
DEV_NEXT_PUBLIC_CONVEX_URL=

# Optional public ingest DSN. Diagnostics remain off until the user explicitly
# enables Share Anonymous Diagnostics in desktop settings.
SENTRY_DSN=
